---
// Shared navigation. The source site has slightly different nav markup per page
// (link sets, active states, anchor targets, and the legal page uses a "back to
// site" nav). We reproduce each variant verbatim, selected by the `page` prop,
// so each route keeps pixel-perfect parity with its source HTML.
interface Props {
  page?: "index" | "how-it-works" | "solutions" | "trust-and-safety" | "legal";
}
const { page = "index" } = Astro.props;
---
{page === "index" && (
  <Fragment>
    <nav role="navigation" aria-label="Main navigation">
      <a href="/" class="nav-logo"><svg class="logo-hex" viewBox="-1 -1 26 26" fill="none" aria-hidden="true"><polygon points="12,1.5 21,6.5 21,17.5 12,22.5 3,17.5 3,6.5" stroke="url(#lhg)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/><defs><linearGradient id="lhg" x1="3" y1="1.5" x2="21" y2="22.5" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="#3b82f6"/><stop offset="100%" stop-color="#1d4ed8"/></linearGradient></defs></svg><span class="logo-word"><span class="logo-text">PensionAble</span><span class="logo-ai">.ai</span></span></a>
      <ul class="nav-links" role="list">
        <li><a href="/solutions">Solutions</a></li>
        <li><a href="/intelligence/">Intelligence</a></li>
        <li><a href="#challenge">Contact</a></li>
      </ul>
      <div class="nav-cta">
        <a href="#challenge" class="btn-nav-primary">Request a demo</a>
        <button class="nav-hamburger" id="hamburger" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>
    <div id="mobile-nav" role="navigation" aria-label="Mobile navigation">
      <a href="/solutions">Solutions</a>
      <a href="/intelligence/">Intelligence</a>
      <a href="/trust-and-safety">Trust &amp; Safety</a>
      <a href="#challenge">Contact</a>
      <a href="#challenge" class="mob-cta">Request a demo</a>
    </div>
  </Fragment>
)}
{page === "solutions" && (
  <Fragment>
    <nav aria-label="Main navigation">
      <a href="/" class="nav-logo"><svg class="logo-hex" viewBox="-1 -1 26 26" fill="none" aria-hidden="true"><polygon points="12,1.5 21,6.5 21,17.5 12,22.5 3,17.5 3,6.5" stroke="url(#lhg)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/><defs><linearGradient id="lhg" x1="3" y1="1.5" x2="21" y2="22.5" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="#3b82f6"/><stop offset="100%" stop-color="#1d4ed8"/></linearGradient></defs></svg><span class="logo-word"><span class="logo-text">PensionAble</span><span class="logo-ai">.ai</span></span></a>
      <ul class="nav-links" role="list">
        <li><a href="/solutions" aria-current="page">Solutions</a></li>
        <li><a href="/intelligence/">Intelligence</a></li>
        <li><a href="/#challenge">Contact</a></li>
      </ul>
      <div class="nav-cta">
        <a href="/#challenge" class="btn-nav-primary">Request a demo</a>
        <button class="nav-hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>
    <div id="mobile-nav" aria-label="Mobile navigation">
      <a href="/solutions" aria-current="page">Solutions</a>
      <a href="/intelligence/">Intelligence</a>
      <a href="/#challenge">Contact</a>
      <a href="/#challenge" class="btn-nav-primary">Request a demo</a>
    </div>
  </Fragment>
)}
{page === "trust-and-safety" && (
  <Fragment>
    <nav role="navigation" aria-label="Main navigation">
      <a href="/" class="nav-logo"><svg class="logo-hex" viewBox="-1 -1 26 26" fill="none" aria-hidden="true"><polygon points="12,1.5 21,6.5 21,17.5 12,22.5 3,17.5 3,6.5" stroke="url(#lhg)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/><defs><linearGradient id="lhg" x1="3" y1="1.5" x2="21" y2="22.5" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="#3b82f6"/><stop offset="100%" stop-color="#1d4ed8"/></linearGradient></defs></svg><span class="logo-word"><span class="logo-text">PensionAble</span><span class="logo-ai">.ai</span></span></a>
      <ul class="nav-links" role="menubar">
        <li><a href="/solutions" role="menuitem">Solutions</a></li>
        <li><a href="/intelligence/" role="menuitem">Intelligence</a></li>
        <li><a href="/#challenge" role="menuitem">Contact</a></li>
      </ul>
      <div class="nav-cta" style="display:flex;align-items:center;gap:0.75rem">
        <a href="/#challenge" class="btn-nav-primary">Request a demo</a>
        <button class="nav-hamburger" id="hamburger" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>
    <div id="mobile-nav" aria-label="Mobile navigation">
      <a href="/solutions">Solutions</a>
      <a href="/intelligence/">Intelligence</a>
      <a href="/#challenge">Contact</a>
      <a href="/#challenge" class="btn-nav-primary">Request a demo</a>
    </div>
  </Fragment>
)}
{page === "how-it-works" && (
  <Fragment>
    <nav role="navigation" aria-label="Main navigation">
      <a href="/" class="nav-logo">PensionAble.ai</a>
      <ul class="nav-links" role="menubar">
        <li><a href="/how-it-works" class="active" role="menuitem">How it works</a></li>
        <li><a href="/trust-and-safety" role="menuitem">Trust &amp; Safety</a></li>
        <li><a href="/#challenge" role="menuitem">Contact</a></li>
      </ul>
      <div class="nav-cta" style="display:flex;align-items:center;gap:0.75rem">
        <a href="/#challenge" class="btn-primary">Request a demo</a>
        <button class="nav-hamburger" id="hamburger" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>
    <div id="mobile-nav" aria-label="Mobile navigation">
      <a href="/how-it-works">How it works</a>
      <a href="/trust-and-safety">Trust &amp; Safety</a>
      <a href="/#challenge">Contact</a>
      <a href="/#challenge" class="btn-primary">Request a demo</a>
    </div>
  </Fragment>
)}
{page === "legal" && (
  <nav>
    <a href="/" class="nav-logo"><svg class="logo-hex" viewBox="-1 -1 26 26" fill="none" aria-hidden="true"><polygon points="12,1.5 21,6.5 21,17.5 12,22.5 3,17.5 3,6.5" stroke="url(#lhg)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/><defs><linearGradient id="lhg" x1="3" y1="1.5" x2="21" y2="22.5" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="#3b82f6"/><stop offset="100%" stop-color="#1d4ed8"/></linearGradient></defs></svg><span class="logo-word"><span class="logo-text">PensionAble</span><span class="logo-ai">.ai</span></span></a>
    <a href="/" class="nav-back">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 8H3M7 4L3 8l4 4"/></svg>
      Back to site
    </a>
  </nav>
)}
